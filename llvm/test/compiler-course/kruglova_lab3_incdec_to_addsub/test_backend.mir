# RUN: llc -mtriple=x86_64-unknown-linux-gnu \
# RUN: -load %p/../../../../build/lib/kruglova_lab3_BACKEND.so \
# RUN: -run-pass=kruglova_incdec_to_addsub-x86 %s -o - | FileCheck %s

--- |
  define void @inc_chain() { ret void }
  define void @dec_chain() { ret void }
  define void @mixed_chain() { ret void }
  define void @break_chain() { ret void }
  define void @zero_result() { ret void }
...

#inc chain
---
name: inc_chain
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: inc_chain

    %0:gr32 = IMPLICIT_DEF
    %1:gr32 = INC32r %0, implicit-def $eflags
    %2:gr32 = INC32r %1, implicit-def $eflags
    %3:gr32 = INC32r %2, implicit-def $eflags

    ; CHECK: [[R:%[0-9]+]]:gr32 = ADD32ri %0, 3

    RET64

# dec chain
---
name: dec_chain
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: dec_chain

    %10:gr32 = IMPLICIT_DEF
    %11:gr32 = DEC32r %10, implicit-def $eflags
    %12:gr32 = DEC32r %11, implicit-def $eflags

    ; CHECK: [[R:%[0-9]+]]:gr32 = SUB32ri %10, 2

    RET64

# mixed chain (inc+inc+dec = +1)
---
name: mixed_chain
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: mixed_chain

    %20:gr32 = IMPLICIT_DEF
    %21:gr32 = INC32r %20, implicit-def $eflags
    %22:gr32 = INC32r %21, implicit-def $eflags
    %23:gr32 = DEC32r %22, implicit-def $eflags

    ; CHECK: [[R:%[0-9]+]]:gr32 = ADD32ri %20, 1

    RET64

# break chain (не должно слиться из-за NOOP)
---
name: break_chain
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: break_chain

    %30:gr32 = IMPLICIT_DEF
    %31:gr32 = INC32r %30, implicit-def $eflags
    NOOP
    %32:gr32 = INC32r %31, implicit-def $eflags

    ; не должно слиться
    ; CHECK: INC32r
    ; CHECK: NOOP
    ; CHECK: INC32r

    RET64

# zero result (inc+dec = 0, должно удалиться)
---
name: zero_result
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: zero_result

    %40:gr32 = IMPLICIT_DEF
    %41:gr32 = INC32r %40, implicit-def $eflags
    %42:gr32 = DEC32r %41, implicit-def $eflags

    ; CHECK: [[R:%[0-9]+]]:gr32 = COPY %40

    RET64

